# Environment: "development" enables permissive dev-only CORS for LAN IPs; set to
# "production" on any real deployment (e.g. Vercel).
ENV=development

# PostgreSQL connection string. For Vercel, point this at a managed Postgres with a pooler
# (e.g. Neon's or Supabase's "pooled connection" string) — a serverless deployment opens far
# more short-lived connections than a normal always-on server would.
DATABASE_URL=postgresql+psycopg2://nyayavault:nyayavault@localhost:5432/nyayavault

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Gemini AI
# Set GEMINI_ENABLED=false to run entirely on deterministic mock AI responses (no key required)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Document storage
# Local disk (used automatically unless BLOB_READ_WRITE_TOKEN is set below):
UPLOAD_DIR=./uploads
# Vercel serverless functions have no persistent disk, so on Vercel, connect a Blob store to
# the project (Storage tab -> Create -> Blob) — BLOB_READ_WRITE_TOKEN is then injected
# automatically. BLOB_PUBLIC_BASE_URL is NOT injected automatically: copy it from that same
# store's settings page (the "https://<id>.public.blob.vercel-storage.com" base URL).
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=
# Vercel's request body limit is 4.5MB regardless of this setting — lower it to match if
# deploying there, so oversized uploads fail with a clear app-level error instead of a raw
# platform 413.
MAX_UPLOAD_SIZE=26214400

# CORS — include the deployed frontend's exact Vercel URL (and any custom domain) once known
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional, used for rate limiting / caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
